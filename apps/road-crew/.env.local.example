# Mapbox access token used by the web and native maps. Use a public (`pk.`)
# token — it is inlined into the client bundle. Without it, maps do not render.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Internal-build Cloudflare Access service token.
# Expo embeds EXPO_PUBLIC_* values into the native build, then the app seeds
# them into SecureStore on first launch. Do not commit the filled-in file.
EXPO_PUBLIC_API_BASE_URL=https://road-crew-beta.andrew-bauer.workers.dev
EXPO_PUBLIC_CF_ACCESS_CLIENT_ID=
EXPO_PUBLIC_CF_ACCESS_CLIENT_SECRET=
